# AgentPay SDK Configuration

# Backend API URL — OPTIONAL.
# The SDK defaults to production (https://api.monocle.3lvn4g.xyz/v1). Set this
# only to point it elsewhere, e.g. a backend running locally. Include the /v1.
AGENT_BACKEND_URL=http://localhost:3001/v1

# API Authentication Key (must match backend's AGENTPAY_API_KEY)
AGENTPAY_API_KEY=test_key_12345
