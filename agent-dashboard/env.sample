# AgentPay Dashboard Configuration

# Backend API URL used directly by the browser. In LOCAL dev you can point this
# at the backend. Leave it UNSET in production so browser auth/API calls go
# through the same-origin proxy (/api/proxy/*), which forwards the session
# cookie and injects the server-only API key.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# =============================================================================
# SERVER-SIDE PROXY (pages/api/proxy) — required for session (email) login
# =============================================================================
# These are read by the Next.js SERVER only and never shipped to the browser.

# Where the proxy forwards requests (your backend's URL)
MONOCLE_BACKEND_URL=http://localhost:3001

# Server-only API key the proxy injects as x-api-key. This is the backend's
# AGENTPAY_API_KEY value. Keeping it here (not NEXT_PUBLIC_) keeps it off the client.
MONOCLE_API_KEY=test_key_12345

# Optional: RPC endpoint for Solana direct queries (if needed in future)
# PRPC_ENDPOINT=https://api.devnet.solana.com
