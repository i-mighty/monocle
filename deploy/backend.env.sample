# Backend environment for the EC2 host.
#
# The real file lives at /opt/monocle/app/deploy/backend.env on the box and is
# NOT committed. systemd loads it via EnvironmentFile= (see
# deploy/monocle-backend.service), and the deploy workflow sources it before
# running migrations.
#
# ┌─ IMPORTANT ────────────────────────────────────────────────────────────────┐
# │ .github/workflows/deploy-backend.yml loads this with:                      │
# │     export $(grep -v '^#' deploy/backend.env | xargs)                      │
# │                                                                            │
# │ That splits on whitespace, so a value containing SPACES or the characters  │
# │ < > | & ; will break the deploy (`<` is read as a shell redirect and       │
# │ `set -e` aborts the run).                                                  │
# │                                                                            │
# │ Keep every value here space-free and unquoted. In particular use a BARE    │
# │ address for EMAIL_FROM — `Monocle <noreply@…>` would break the deploy.     │
# └────────────────────────────────────────────────────────────────────────────┘

# --- core ---
NODE_ENV=production
PORT=3001
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# --- sessions (required for ALL user login: wallet SIWS + email/password) ---
# Must be >= 32 chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_min_32_chars
AUTH_JWT_TTL_SECONDS=86400

# --- SDK / machine auth ---
AGENTPAY_API_KEY=CHANGE_ME

# --- admin ---
# Gates admin endpoints, including POST /v1/auth/admin/verify-email, which marks
# an account's email verified without sending a code (pre-seed a demo account, or
# rescue a user if mail delivery breaks). Admin routes are denied outright when
# this is unset.
ADMIN_API_KEY=CHANGE_ME

# --- KYC break-glass ---
# Email verification is enforced on settle/withdraw/agent-registration whenever a
# user session is present. Set to "off" ONLY to disable that gate in an
# emergency (e.g. email delivery down mid-demo); every skipped check is logged.
# Unset or "on" = enforced. Leave it unset in normal operation.
# KYC_ENFORCEMENT=on

# --- email + KYC (required for email login and email verification) ---
# Resend API key (https://resend.com) — create a key and verify a sending domain.
RESEND_API_KEY=re_CHANGE_ME
# Bare address only, no display name, no spaces (see the warning above).
# Must be on a domain verified in Resend.
EMAIL_FROM=noreply@yourdomain.com
EMAIL_VERIFICATION_TTL_MINUTES=15

# --- solana ---
SOLANA_RPC=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
SOLANA_PAYER_SECRET=[]

# --- arena (optional) ---
# ARENA_ENABLED=false
# ARENA_TICK_MS=60000
# TXLINE_MODE=sim
