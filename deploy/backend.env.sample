# Backend environment for the EC2 host.
#
# The real file lives at /opt/monocle/app/deploy/backend.env on the box and is
# NOT committed. systemd loads it via EnvironmentFile= (see
# deploy/monocle-backend.service), and the deploy workflow sources it before
# running migrations.
#
# ┌─ QUOTING ──────────────────────────────────────────────────────────────────┐
# │ This file is sourced (`set -a; . backend.env; set +a`) by systemd and by    │
# │ the deploy workflow, so it must be valid shell.                            │
# │                                                                            │
# │ Any value containing spaces or < > | & ; MUST be quoted:                   │
# │     EMAIL_FROM="Monocle <noreply@yourdomain.com>"   # ok, quoted           │
# │     EMAIL_FROM=Monocle <noreply@yourdomain.com>     # BREAKS the deploy    │
# │                                                                            │
# │ Simplest is to avoid spaces entirely and use a bare address for            │
# │ EMAIL_FROM — Resend accepts one, and there's nothing to get wrong.         │
# │                                                                            │
# │ (systemd's EnvironmentFile parses KEY=VALUE and does NOT expand shell, so   │
# │ quotes are handled there too — but keep values simple and this stays true.) │
# └────────────────────────────────────────────────────────────────────────────┘

# --- core ---
NODE_ENV=production
PORT=3001
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# --- sessions (required for ALL user login: wallet SIWS + email/password) ---
# Must be >= 32 chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_min_32_chars
AUTH_JWT_TTL_SECONDS=86400

# --- SDK / machine auth ---
AGENTPAY_API_KEY=CHANGE_ME

# --- admin ---
# Gates admin endpoints, including POST /v1/auth/admin/verify-email, which marks
# an account's email verified without sending a code (pre-seed a demo account, or
# rescue a user if mail delivery breaks). Admin routes are denied outright when
# this is unset.
ADMIN_API_KEY=CHANGE_ME

# Signs admin SESSION tokens (Authorization: Bearer admin:...), which are a
# separate path from X-Admin-Key above. Optional: leave it unset and session
# tokens are simply disabled, which is the safe default — X-Admin-Key still works.
#
# It has no fallback on purpose. This used to fall back to ADMIN_API_KEY and then
# to the literal "default-secret", so with neither variable set every token was
# signed with a string published in the source and anyone could mint one that
# passed verification.
#
# Do NOT reuse ADMIN_API_KEY here: one leak would then compromise both. Use at
# least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ADMIN_SESSION_SECRET=

# --- KYC break-glass ---
# Email verification is enforced on settle/withdraw/agent-registration whenever a
# user session is present. Set to "off" ONLY to disable that gate in an
# emergency (e.g. email delivery down mid-demo); every skipped check is logged.
# Unset or "on" = enforced. Leave it unset in normal operation.
# KYC_ENFORCEMENT=on

# --- email + KYC (required for email login and email verification) ---
# Two providers; the service prefers SMTP, then falls back to Resend.
#
# Option 1 — SMTP (Brevo). Delivers to ANY recipient, so use this for real users.
#   In Brevo: authorize this server's IP (54.242.122.233) under Authorized IPs,
#   or sends fail with "525 Unauthorized IP address". Also add a validated
#   sender under Settings -> Senders and use it as EMAIL_FROM.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME@smtp-brevo.com
SMTP_PASS=CHANGE_ME
#
# Option 2 — Resend (leave SMTP_HOST empty to use this). The shared onboarding
# domain only delivers to the account owner, so a verified domain is required for
# real users.
# RESEND_API_KEY=re_CHANGE_ME

# Sender — must be a validated sender for the chosen provider. A bare address needs
# no quoting; for a display name, quote it: EMAIL_FROM="Monocle <noreply@domain>"
EMAIL_FROM=noreply@yourdomain.com
EMAIL_VERIFICATION_TTL_MINUTES=15

# --- solana ---
SOLANA_RPC=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
SOLANA_PAYER_SECRET=[]

# --- arena (optional) ---
# ARENA_ENABLED=false
# ARENA_TICK_MS=60000
# TXLINE_MODE=sim
